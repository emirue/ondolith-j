{
  "components" : {
    "schemas" : {
      "Database" : {
        "properties" : {
          "server_version" : {
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "Health" : {
        "properties" : {
          "state" : {
            "type" : "string"
          },
          "version" : {
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "InstallRequest" : {
        "properties" : {
          "admin_email" : {
            "format" : "email",
            "maxLength" : 254,
            "minLength" : 0,
            "type" : "string"
          },
          "admin_password" : {
            "maxLength" : 2147483647,
            "minLength" : 10,
            "type" : "string"
          },
          "admin_password_confirm" : {
            "type" : "string"
          },
          "db_host" : {
            "maxLength" : 255,
            "minLength" : 0,
            "pattern" : "[A-Za-z0-9._:\\[\\]-]+",
            "type" : "string"
          },
          "db_name" : {
            "maxLength" : 63,
            "minLength" : 0,
            "type" : "string"
          },
          "db_password" : {
            "maxLength" : 255,
            "minLength" : 0,
            "type" : "string"
          },
          "db_port" : {
            "format" : "int32",
            "maximum" : 65535,
            "minimum" : 1,
            "type" : "integer"
          },
          "db_sslmode" : {
            "pattern" : "disable|require|verify-ca|verify-full",
            "type" : "string"
          },
          "db_user" : {
            "maxLength" : 63,
            "minLength" : 0,
            "type" : "string"
          },
          "site_name" : {
            "type" : "string"
          },
          "site_type" : {
            "pattern" : "cms|shop",
            "type" : "string"
          },
          "site_url" : {
            "maxLength" : 2048,
            "minLength" : 0,
            "pattern" : "https?://[^\\s/?#]+[^\\s]*",
            "type" : "string"
          }
        },
        "required" : [ "admin_email", "admin_password", "admin_password_confirm", "db_host", "db_name", "db_sslmode", "db_user", "site_name", "site_url" ],
        "type" : "object"
      },
      "LoginRequest" : {
        "properties" : {
          "email" : {
            "maxLength" : 254,
            "minLength" : 0,
            "type" : "string"
          },
          "password" : {
            "maxLength" : 1000,
            "minLength" : 0,
            "type" : "string"
          }
        },
        "required" : [ "email", "password" ],
        "type" : "object"
      },
      "Me" : {
        "properties" : {
          "can" : {
            "additionalProperties" : {
              "type" : "boolean"
            },
            "type" : "object"
          },
          "user" : {
            "$ref" : "#/components/schemas/User"
          }
        },
        "type" : "object"
      },
      "MigrationRow" : {
        "properties" : {
          "description" : {
            "type" : "string"
          },
          "installed_on" : {
            "format" : "date-time",
            "type" : "string"
          },
          "success" : {
            "type" : "boolean"
          },
          "version" : {
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "OplogItem" : {
        "properties" : {
          "action" : {
            "type" : "string"
          },
          "actor_email" : {
            "type" : "string"
          },
          "actor_user_id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "created_at" : {
            "format" : "date-time",
            "type" : "string"
          },
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "ip" : {
            "type" : "string"
          },
          "summary" : {
            "type" : "string"
          },
          "target_id" : {
            "type" : "string"
          },
          "target_type" : {
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "OplogPage" : {
        "properties" : {
          "items" : {
            "items" : {
              "$ref" : "#/components/schemas/OplogItem"
            },
            "type" : "array"
          },
          "page" : {
            "format" : "int32",
            "type" : "integer"
          },
          "page_size" : {
            "format" : "int32",
            "type" : "integer"
          },
          "total" : {
            "format" : "int64",
            "type" : "integer"
          }
        },
        "type" : "object"
      },
      "ProblemDetail" : {
        "properties" : {
          "detail" : {
            "type" : "string"
          },
          "errors" : {
            "additionalProperties" : {
              "type" : "string"
            },
            "type" : "object"
          },
          "instance" : {
            "format" : "uri",
            "type" : "string"
          },
          "status" : {
            "format" : "int32",
            "type" : "integer"
          },
          "title" : {
            "type" : "string"
          },
          "type" : {
            "format" : "uri",
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "SettingsRequest" : {
        "properties" : {
          "name" : {
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "Site" : {
        "properties" : {
          "name" : {
            "type" : "string"
          },
          "type" : {
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "SystemInfo" : {
        "properties" : {
          "database" : {
            "$ref" : "#/components/schemas/Database"
          },
          "migrations" : {
            "items" : {
              "$ref" : "#/components/schemas/MigrationRow"
            },
            "type" : "array"
          },
          "pending_count" : {
            "format" : "int32",
            "type" : "integer"
          },
          "version" : {
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "User" : {
        "properties" : {
          "display_name" : {
            "type" : "string"
          },
          "email" : {
            "type" : "string"
          }
        },
        "type" : "object"
      }
    }
  },
  "info" : {
    "title" : "OpenAPI definition",
    "version" : "v0"
  },
